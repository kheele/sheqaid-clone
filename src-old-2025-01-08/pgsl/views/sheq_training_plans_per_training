CREATE OR REPLACE VIEW "public"."sheq_training_plans_per_training" AS
 SELECT o.training_id AS "group",
    o.company_id,
    o.client_id,
    o.project_id,
    o.site_id,

     ( SELECT sum(p_1.cost) AS cost
            FROM sheq_training_matrices p_1
 	 		JOIN sheq_training_plans p ON (p_1.id = p.training_id)
           WHERE (p.training_id = o.training_id)) AS cost,
     ( SELECT count(p_1.id) AS count
            FROM sheq_training_plans p_1
           WHERE ((p_1.training_id = o.training_id) AND (p_1.status = 'Not Started'::training_plan_status))) AS status_not_started,
     ( SELECT count(p_1.id) AS count
            FROM sheq_training_plans p_1
           WHERE ((p_1.training_id = o.training_id) AND (p_1.status = 'Outstanding'::training_plan_status))) AS status_outstanding,
     ( SELECT count(p_1.id) AS count
            FROM sheq_training_plans p_1
           WHERE ((p_1.training_id = o.training_id) AND (p_1.status = 'In Progress'::training_plan_status))) AS status_in_progress,
     ( SELECT count(p_1.id) AS count
            FROM sheq_training_plans p_1
           WHERE ((p_1.training_id = o.training_id) AND (p_1.status = 'Completed'::training_plan_status))) AS status_completed,

     calc_training_results_passed_by_plan(o.training_id) AS results_passed,
     calc_training_results_failed_by_plan(o.training_id) AS results_failed,
     calc_training_results_avg_by_plan(o.training_id) AS results_average,

     json_training_plan_list_by_training_id(o.training_id) AS list,

 	cp_json_employee_list_by_plan_training(o.training_id) AS employee_list,
 	cp_json_job_position_list_by_plan_training(o.training_id) AS job_position_list,
    cp_json_year_list_by_plan_training(o.training_id) AS year_list,
 	cp_json_attendance_list_by_plan_training(o.training_id) AS attendance_list

   FROM sheq_training_plans o WHERE o.training_id IS NOT NULL
  GROUP BY o.training_id, o.company_id, o.client_id, o.project_id, o.site_id;



    json_employee_list_by_plan(o.*) AS employee_list,
    json_job_position_list_by_plan(o.*) AS job_position_list,
    json_year_list_by_plan(o.*) AS year_list,
    json_attendance_list_by_plan(o.*) AS attendance_list,
    json_training_plan_list_by_training_id(o.training_id) AS list,
    sheq_training_matrices_cost_by_plan(o.*) AS cost,

    calc_training_results_failed_by_plan(o.training_id) AS results_failed,
    calc_training_results_passed_by_plan(o.training_id) AS results_passed,
    calc_training_results_avg_by_plan(o.training_id) AS results_average,