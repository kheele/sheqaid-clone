CREATE OR REPLACE FUNCTION public.cp_json_year_list_by_plan_employee(employee_id bigint)
 RETURNS json
 LANGUAGE sql
 STABLE
AS $function$
    SELECT json_agg(y.year) AS json_agg
    FROM sheq_training_plans y
    WHERE y.employee_id = employee_id
$function$

