CREATE OR REPLACE FUNCTION public.cp_json_course_list_by_plan_employee(employee_id bigint)
 RETURNS json
 LANGUAGE sql
 STABLE
AS $function$
    SELECT json_agg(row_to_json(c.*)) AS json_agg
    FROM sheq_training_plans o
    JOIN sheq_training_courses c ON o.course_id = c.id
    WHERE o.employee_id = employee_id
$function$

