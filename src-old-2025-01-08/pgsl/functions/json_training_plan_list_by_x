CREATE OR REPLACE FUNCTION public.json_training_plan_list_by_year(_year integer)
 RETURNS json
 LANGUAGE sql
 STABLE
AS $function$
    SELECT json_agg(row_to_json(o.*)) AS json_agg
    FROM sheq_training_plans o
    WHERE o.year = _year
$function$

CREATE OR REPLACE FUNCTION public.json_training_plan_list_by_course(_course_id bigint)
 RETURNS json
 LANGUAGE sql
 STABLE
AS $function$
    SELECT json_agg(row_to_json(p.*)) AS json_agg
    FROM sheq_training_courses o
    JOIN sheq_training_plans p ON o.id = p.course_id
    WHERE o.id = _course_id
$function$

