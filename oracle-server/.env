PORT = 5000
PORT_SECURE = 443

CONTRACTORS_ENDPOINT = https://contractors.cloud.sheqaid.com/
HR_ENDPOINT = https://hr.cloud.sheqaid.com/
HASURA_ENDPOINT = https://hasura.cloud.sheqaid.com
HASURA_RELAY_ENDPOINT = https://hasura.cloud.sheqaid.com/v1beta1/relay
HASURA_GRAPHQL_ENDPOINT = https://hasura.cloud.sheqaid.com/v1/graphql
HASURA_REST_ENDPOINT = https://hasura.cloud.sheqaid.com/api/rest

#CONTRACTORS_ENDPOINT = http://localhost:5001/
#HR_ENDPOINT = http://localhost:5002/

ENVIRONMENT = production
#ENVIRONMENT = development

GCLOUD_PROJECT = "sheqsolve"
GOOGLE_APPLICATION_CREDENTIALS = ./firebase/service-account.json

CERT_PRIVATE_KEY = ./certs/ubuntu-sheqaid-key.perm
CERT_PUBLIC_KEY = ./certs/ubuntu-sheqaid-pub.perm
