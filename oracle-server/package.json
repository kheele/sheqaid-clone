{
        "name": "sheqaid-server",
        "description": "Cloud Functions",
        "scripts": {
                "test": "mocha --reporter spec",
                "lint": "eslint .",
                "start:bun": "bun src/index.js",
                "start:node": "nodemon -r dotenv/config src/index.js",
                "docker:prune": "docker system prune -a",
                "docker:build:node": "docker build --no-cache --progress=plain . -t rhespo/sheqaid-server",
                "docker:build:bun": "docker build --no-cache --progress=plain . -t rhespo/sheqaid-server-bun",
                "docker:push:node": "docker push rhespo/sheqaid-server",
                "docker:push:bun": "docker push rhespo/sheqaid-server-bun",
                "docker:buildANDpush:node": "docker build . -t rhespo/sheqaid-server && docker push rhespo/sheqaid-server",
                "docker:buildANDpush:bun": "docker build . -t rhespo/sheqaid-server-bun && docker push rhespo/sheqaid-server-bun",
                "add:cors": "gsutil cors set cors.json gs://sheqsolve.appspot.com",
                "install:mod": "npm install -g npm@10.2.5",
                "install:remove": "rm -rf node_modules package-lock.json",
                "install:all": "npm install --global yarn",
                "neon:build": "npm run build"
        },
        "engines": {
                "node": ">=18.0.0"
        },
        "main": "src/index.js",
        "dependencies": {
                "@google-cloud/storage": "6.9.4",
                "@socket.io/redis-adapter": "^8.2.1",
                "@urql/core": "^4.1.3",
                "atob": "^2.1.2",
                "cookie-parser": "^1.4.6",
                "cors": "^2.8.5",
                "csurf": "^1.11.0",
                "ejs": "^3.1.6",
                "exceljs": "^4.3.0",
                "express": "^4.18.2",
                "express-session": "^1.17.3",
                "express-socket.io-session": "^1.3.5",
                "file-type": "^19.0.0",
                "firebase": "^9.9.0",
                "firebase-admin": "^8.10.0",
                "firebase-functions": "^3.6.1",
                "formidable": "^1.2.2",
                "fs-extra": "10.1.0",
                "googleapis": "^67.1.0",
                "helmet": "^7.0.0",
                "js-excel-template": "^3.0.2",
                "mime": "^3.0.0",
                "moment": "2.24.0",
                "moment-timezone": "0.5.13",
                "morgan": "^1.10.0",
                "node-blob": "0.0.2",
                "node-fetch": "^2.6.1",
                "nodemailer": "^6.4.16",
                "redis": "^4.6.9",
                "socket.io": "^4.6.0",
                "socket.io-client": "^4.7.2",
                "thumbsupply": "^0.4.0",
                "uuid": "^9.0.0",
                "xlsx": "^0.18.5"
        },
        "devDependencies": {
                "@babel/core": "^7.2.0",
                "@babel/preset-env": "^7.2.0",
                "@babel/register": "^7.0.0",
                "@types/mocha": "^9.1.0",
                "chai": "^4.3.6",
                "chai-as-promised": "^7.1.1",
                "dotenv": "^16.0.3",
                "eslint": "^5.12.0",
                "eslint-plugin-promise": "^4.0.1",
                "firebase-functions-test": "^0.2.3",
                "mocha": "^9.2.2",
                "nodemon": "^2.0.22",
                "sinon": "^13.0.1"
        },
        "private": true
}
