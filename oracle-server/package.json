{
  "name": "sheqaid-server",
  "description": "Cloud Functions",
  "scripts": {
    "test": "mocha --reporter spec",
    "lint": "eslint .",
    "start": "nodemon -r dotenv/config src/index.js",
    "docker:build": "docker build --no-cache . -t rhespo/sheqaid-server",
    "docker:push": "docker push rhespo/sheqaid-server",
    "docker:build&push": "docker build . -t rhespo/sheqaid-server && docker push rhespo/sheqaid-server",
    "add:cors": "gsutil cors set cors.json gs://sheqsolve.appspot.com",
    "install:mod": "npm i thumbsupply@latest --save",
    "install:all": "npm install"
  },
  "engines": {
    "node": "16"
  },
  "main": "src/index.js",
  "dependencies": {
    "@google-cloud/storage": "6.9.4",
    "atob": "^2.1.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csurf": "^1.11.0",
    "docx-pdf": "0.0.1",
    "ejs": "^3.1.6",
    "exceljs": "^4.3.0",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "firebase": "^9.9.0",
    "firebase-admin": "^8.10.0",
    "firebase-functions": "^3.6.1",
    "formidable": "^1.2.2",
    "fs-extra": "10.1.0",
    "googleapis": "^67.1.0",
    "html-pdf": "^2.2.0",
    "js-excel-template": "^3.0.2",
    "mime": "^3.0.0",
    "moment": "2.24.0",
    "moment-timezone": "0.5.13",
    "morgan": "^1.10.0",
    "node-blob": "0.0.2",
    "node-fetch": "^2.6.1",
    "nodemailer": "^6.4.16",
    "thumbsupply": "^0.4.0",
    "uuid": "^9.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/mocha": "^9.1.0",
    "chai": "^4.3.6",
    "chai-as-promised": "^7.1.1",
    "dotenv": "^16.0.3",
    "eslint": "^5.12.0",
    "eslint-plugin-promise": "^4.0.1",
    "firebase-functions-test": "^0.2.3",
    "mocha": "^9.2.2",
    "nodemon": "^2.0.22",
    "sinon": "^13.0.1"
  },
  "private": true
}
