CREATE OR REPLACE VIEW "public"."sheq_training_plans_per_year" AS
 SELECT o.year AS "group",
    o.company_id,
    o.client_id,
    o.project_id,
    o.site_id,

     ( SELECT sum(p_1.cost) AS cost
            FROM sheq_training_matrices p_1
 	 		JOIN sheq_training_plans p ON (p_1.id = p.training_id)
           WHERE (p.year = o.year)) AS cost,
     ( SELECT count(p_1.id) AS count
            FROM sheq_training_plans p_1
           WHERE ((p_1.year = o.year) AND (p_1.status = 'Not Started'::training_plan_status))) AS status_not_started,
     ( SELECT count(p_1.id) AS count
            FROM sheq_training_plans p_1
           WHERE ((p_1.year = o.year) AND (p_1.status = 'Outstanding'::training_plan_status))) AS status_outstanding,
     ( SELECT count(p_1.id) AS count
            FROM sheq_training_plans p_1
           WHERE ((p_1.year = o.year) AND (p_1.status = 'In Progress'::training_plan_status))) AS status_in_progress,
     ( SELECT count(p_1.id) AS count
            FROM sheq_training_plans p_1
           WHERE ((p_1.year = o.year) AND (p_1.status = 'Completed'::training_plan_status))) AS status_completed,

     calc_year_results_passed_by_plan(o.year) AS results_passed,
     calc_year_results_failed_by_plan(o.year) AS results_failed,
     calc_year_results_avg_by_plan(o.year) AS results_average,

     json_training_plan_list_by_year(o.year) AS list,

     cp_json_employee_list_by_plan_year(o.year) AS employee_list,
     cp_json_job_position_list_by_plan_year(o.year) AS job_position_list,
 	cp_json_course_list_by_plan_year(o.year) AS course_list,
 	cp_json_training_list_by_plan_year(o.year) AS training_list,
 	cp_json_attendance_list_by_plan_year(o.year) AS attendance_list

   FROM sheq_training_plans o WHERE o.year IS NOT NULL
  GROUP BY o.year, o.company_id, o.client_id, o.project_id, o.site_id;



     //to delete
    json_employee_list_by_plan(o.*) AS employee_list,
    json_job_position_list_by_plan(o.*) AS job_position_list,
    json_course_list_by_plan(o.*) AS course_list,
    json_training_list_by_plan(o.*) AS training_list,
    json_attendance_list_by_plan(o.*) AS attendance_list,

    json_training_plan_list_by_year(o.year) AS list,
    sheq_training_matrices_cost_by_plan(o.*) AS cost,

    calc_year_results_failed_by_plan(o.year) AS results_failed,
    calc_year_results_passed_by_plan(o.year) AS results_passed,
    calc_year_results_avg_by_plan(o.year) AS results_average,
