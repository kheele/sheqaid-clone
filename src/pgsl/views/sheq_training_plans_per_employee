CREATE OR REPLACE VIEW "public"."sheq_training_plans_per_employee" AS
 SELECT o.employee_id AS "group",
     o.company_id,
     o.client_id,
     o.project_id,
     o.site_id,

     ( SELECT sum(p_1.cost) AS cost
            FROM sheq_training_matrices p_1
 	 		JOIN sheq_training_plans p ON (p_1.id = p.training_id)
           WHERE (p.employee_id = o.employee_id)) AS cost,
     ( SELECT count(p_1.id) AS count
            FROM sheq_training_plans p_1
           WHERE ((p_1.employee_id = o.employee_id) AND (p_1.status = 'Not Started'::training_plan_status))) AS status_not_started,
     ( SELECT count(p_1.id) AS count
            FROM sheq_training_plans p_1
           WHERE ((p_1.employee_id = o.employee_id) AND (p_1.status = 'Outstanding'::training_plan_status))) AS status_outstanding,
     ( SELECT count(p_1.id) AS count
            FROM sheq_training_plans p_1
           WHERE ((p_1.employee_id = o.employee_id) AND (p_1.status = 'In Progress'::training_plan_status))) AS status_in_progress,
     ( SELECT count(p_1.id) AS count
            FROM sheq_training_plans p_1
           WHERE ((p_1.employee_id = o.employee_id) AND (p_1.status = 'Completed'::training_plan_status))) AS status_completed,

     calc_employee_results_passed_by_plan(o.employee_id) AS results_passed,
     calc_employee_results_failed_by_plan(o.employee_id) AS results_failed,
     calc_employee_results_avg_by_plan(o.employee_id) AS results_average,

     json_training_plan_list_by_employee_id(o.employee_id) AS list,

     cp_json_year_list_by_plan_employee(o.employee_id) AS year_list,
 	cp_json_course_list_by_plan_employee(o.employee_id) AS course_list,
 	cp_json_training_list_by_plan_employee(o.employee_id) AS training_list,
 	cp_json_attendance_list_by_plan_employee(o.employee_id) AS attendance_list

    FROM sheq_training_plans o
   GROUP BY o.employee_id, o.company_id, o.client_id, o.project_id, o.site_id;