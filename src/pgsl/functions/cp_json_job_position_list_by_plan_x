CREATE OR REPLACE FUNCTION public.cp_json_job_position_list_by_plan_course(course_id bigint)
 RETURNS json
 LANGUAGE sql
 STABLE
AS $function$
    SELECT json_agg(row_to_json(p.*)) AS json_agg
    FROM sheq_training_plans o
    JOIN default_job_positions p ON o.job_position_id = p.id
    WHERE o.course_id = course_id
$function$

