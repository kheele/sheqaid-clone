CREATE OR REPLACE FUNCTION public.cp_json_employee_list_by_plan_course(course_id bigint)
 RETURNS json
 LANGUAGE sql
 STABLE
AS $function$
    SELECT json_agg(row_to_json(e.*)) AS json_agg
    FROM sheq_training_plans o
    JOIN hr_employees e ON o.employee_id = e.id
    WHERE o.course_id = course_id
$function$

