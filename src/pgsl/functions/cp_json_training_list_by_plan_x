CREATE OR REPLACE FUNCTION public.cp_json_training_list_by_plan_employee(employee_id bigint)
 RETURNS json
 LANGUAGE sql
 STABLE
AS $function$
    SELECT json_agg(row_to_json(t.*)) AS json_agg
    FROM sheq_training_plans o
    JOIN sheq_training_matrices t ON o.training_id = t.id
    WHERE o.employee_id = employee_id
$function$

