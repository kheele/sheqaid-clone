{
  "name": "sheq-solve",
  "version": "0.1.0",
  "private": true,
  "homepage": "./",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "mocha",

    "start:dev:new": "webpack-dev-server --env.ENVIRONMENT=development --content-base src/ --mode development --watch --watch-poll",
    "start:dev": "node --max-old-space-size=12192 scripts/start.js",

    "build:prod": "node --max-old-space-size=8192 scripts/build.js",
    "build:prod-admin": "node --max-old-space-size=8192 scripts/build-admin.js",
    "build:prod-forms": "node --max-old-space-size=8192 scripts/build-forms.js",
    "build:prod-alpha-dev": "node --max-old-space-size=8192 scripts/build-alpha-dev.js",
    "build:prod-beta-dev": "node --max-old-space-size=8192 scripts/build-beta-dev.js",

    "deploy:hosting-prod-beta-dev": "node --max-old-space-size=8192 scripts/build-beta-dev.js && cd firebase/ && firebase deploy --only hosting:beta-dev",
    "deploy:hosting:web,desktop,mobile,main,contractors,hr": "node --max-old-space-size=8192 scripts/build.js && cd firebase/ && firebase deploy --only hosting:web && firebase deploy --only hosting:desktop && firebase deploy --only hosting:mobile && firebase deploy --only hosting:main && firebase deploy --only hosting:contractors-2023 && firebase deploy --only hosting:hr-2023",

    "relay": "relay-compiler",
    "relay:watch": "relay-compiler --watch",

    "hasura-get-schema": "gq https://hasura.cloud.sheqaid.com/v1beta1/relay --introspect > schema.graphql",
    "get-graphql-schema-relay": "get-graphql-schema https://hasura.cloud.sheqaid.com/v1beta1/relay > ./schema.graphql",

    "install-modules": "npm i uuid --save",
    "uninstall-modules": "npm uninstall copy-webpack-plugin",
    "install": "npm i eslint-loader@^4.0.2",
    "clean": "npm cache clean --force",

    "storage-cors-get": "gsutil cors get gs://sheqsolve.appspot.com",
    "storage-cors-set--prod": "gsutil cors set storage-cors-prod.json gs://sheqsolve.appspot.com",
    "storage-cors-set--dev": "gsutil cors set storage-cors-dev.json gs://sheqsolve.appspot.com",
    "storage-cors-cache-clear": "gsutil setmeta -h \"Cache-Control:no-cache\" gs://sheqsolve.appspot.com/plugin_sheq_assist_employees/Nkll3PE55tSA6IGDwabT/optional_info/living_addr_doc.jpg"
  },
  "relay": {
    "src": "./src",
    "language": "javascript",
    "schema": "./schema.relay.graphql",
    "exclude": [
      "**/node_modules/**",
      "**/node_modules2/**",
      "**/__mocks__/**",
      "**/__generated__/**",
      "**/DefaultGraphQL/**"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "roots": [
      "<rootDir>/src"
    ],
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}",
      "!src/**/*.d.ts"
    ],
    "setupFiles": [
      "react-app-polyfill/jsdom"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/src/setupTests.js"
    ],
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.{js,jsx,ts,tsx}",
      "<rootDir>/src/**/*.{spec,test}.{js,jsx,ts,tsx}"
    ],
    "testEnvironment": "jest-environment-jsdom-fourteen",
    "transform": {
      "^.+\\.(js|jsx|ts|tsx)$": "<rootDir>/node_modules/babel-jest",
      "^.+\\.css$": "<rootDir>/config/jest/cssTransform.js",
      "^(?!.*\\.(js|jsx|ts|tsx|css|json)$)": "<rootDir>/config/jest/fileTransform.js"
    },
    "transformIgnorePatterns": [
      "[/\\\\]node_modules[/\\\\].+\\.(js|jsx|ts|tsx)$",
      "^.+\\.module\\.(css|sass|scss)$"
    ],
    "modulePaths": [],
    "moduleNameMapper": {
      "^react-native$": "react-native-web",
      "^.+\\.module\\.(css|sass|scss)$": "identity-obj-proxy"
    },
    "moduleFileExtensions": [
      "web.js",
      "js",
      "web.ts",
      "ts",
      "web.tsx",
      "tsx",
      "json",
      "web.jsx",
      "jsx",
      "node"
    ],
    "watchPlugins": [
      "jest-watch-typeahead/filename",
      "jest-watch-typeahead/testname"
    ]
  },
  "dependencies": {
    "@babel/core": "7.9.0",
