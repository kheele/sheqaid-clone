3. Reset Table identity
    SELECT column_name, column_default
    FROM information_schema.columns
    WHERE table_name = 'default_job_categories' AND column_default LIKE '%nextval%';

    ALTER SEQUENCE default_job_categories_id_seq RESTART WITH 1;
4. Create ENUM TYPE
    ALTER TYPE hr_employees_doc_type RENAME TO hr_employees_doc_type_old;
    CREATE TYPE status AS ENUM (
        'active',
        'inactive',
        'deleted'
    );
    ALTER TABLE hr_employees_docs ALTER COLUMN _type TYPE hr_employees_doc_type USING _type::text::hr_employees_doc_type;
    DROP TYPE hr_employees_doc_type_old;

