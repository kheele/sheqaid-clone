--1. sheq_training_plans_per_course
-- sheq_training_plans_per_employee
-- sheq_training_plans_per_job_position
-- sheq_training_plans_per_training

--.1
CREATE OR REPLACE VIEW "public"."sheq_training_plans_per_course" AS
 SELECT DISTINCT o.course_id AS "group",
    o.company_id,
    o.client_id,
    o.project_id,
    o.site_id,
    json_employee_list_by_plan(o) AS employee_list,
    json_job_position_list_by_plan(o.*) AS job_position_list,
    json_year_list_by_plan(o.*) AS year_list,
    json_training_list_by_plan(o.*) AS training_list,
    json_attendance_list_by_plan(o.*) AS attendance_list,
    json_training_plan_list_by_course_id(o.course_id) AS list,//
    sheq_training_matrices_cost_by_plan(o.*) AS cost,//
    count_plan_status_by_course_id(o.course_id, 'Outstanding'::text) AS status_outstanding,
    count_status_by_plan(o.*, 'Completed'::text) AS status_completed,
    calc_course_results_failed_by_plan(o.course_id) AS results_failed,
    calc_course_results_passed_by_plan(o.course_id) AS results_passed,
    calc_course_results_avg_by_plan(o.course_id) AS results_average,
    count_status_by_plan(o.*, 'Not Started'::text) AS status_not_started
   FROM sheq_training_plans o
  GROUP BY "group", o.id;

--.2
CREATE OR REPLACE VIEW "public"."sheq_training_plans_per_employee" AS
 SELECT o.employee_id AS "group",
    o.company_id,
    o.client_id,
    o.project_id,
    o.site_id,
    cp_json_year_list_by_plan_employee(o.employee_id) AS year_list,
    //json_year_list_by_plan(o.*) AS year_list,

    cp_json_course_list_by_plan_employee(o.employee_id) AS course_list,
    //json_course_list_by_plan(o.*) AS course_list,

    cp_json_training_list_by_plan_employee(o.employee_id) AS training_list,
    //json_training_list_by_plan(o.*) AS training_list,

	cp_json_attendance_list_by_plan_employee(o.employee_id) AS attendance_list,
    //json_attendance_list_by_plan(o.*) AS attendance_list,

    json_training_plan_list_by_employee_id(o.employee_id) AS list,//
    sheq_training_matrices_cost_by_plan(o.*) AS cost,//
    count_status_by_plan(o.*, 'Outstanding'::text) AS status_outstanding,//
    count_status_by_plan(o.*, 'Completed'::text) AS status_completed,//
    calc_employee_results_failed_by_plan(o.employee_id) AS results_failed,//
    calc_employee_results_passed_by_plan(o.employee_id) AS results_passed,//
    calc_employee_results_avg_by_plan(o.employee_id) AS results_average,//
    count_status_by_plan(o.*, 'Not Started'::text) AS status_not_started//
   FROM sheq_training_plans o
  GROUP BY o.employee_id, o.id;

