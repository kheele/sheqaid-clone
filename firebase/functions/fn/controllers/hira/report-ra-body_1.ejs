                    
<% list.forEach(({id, data: {created_at, activity, expiry_date, risk_tolerance, list}}, n) => {%>
<label class="w-full font-size-17 padding-5"><%= (n+1)%>. <%= activity%></label> 
<div class="tbody">
    <% list.forEach(({
            task_step, hazard, risk,
            risk_type, control_measure_list, control_measure_list_additional,
            likelihood_1, frequency_1, consequence_1,
            likelihood_2, frequency_2, consequence_2,
            likelihood_3, frequency_3, consequence_3,
            responsible_person, target_date, due_date
        }, n) => {
        const contains = val => {
          val += " Risk";
          return risk_type === val || (risk_type.contains && risk_type.contains(val));
        };
        
        let responsible_personName = null;
        if(responsible_person) {
            const {fname, lname, data} = responsible_person;
            responsible_personName = (fname || data.fname).charAt(0).toUpperCase() + '. ' + (lname || data.lname);
        } else {
            responsible_personName = "";
        }
        
        const calcRiskRating = (likelihood, frequency, consequence) => {
            if(hasFrequency) {
                return ((likelihood + frequency) / 2) * consequence;
            } else {
                return likelihood * consequence;
            }
        };
        const calcRiskRank = (n) => {
            if (n <= 4) {
                return 'Low';
            } else if (n <= 8) {
                return 'Medium';
            } else if (n <= 15) {
                return 'High';
            } else if (n > 15){
                return 'Extreme';
            }
        };
        
        const risk_rating_1 = calcRiskRating(likelihood_1, frequency_1, consequence_1);
        const risk_rank_1 = calcRiskRank(risk_rating_1);
        
        const risk_rating_2 = calcRiskRating(likelihood_2, frequency_2, consequence_2);        
        const risk_rank_2 = calcRiskRank(risk_rating_2);
        
        let risk_rating_3, risk_rank_3;
        if(hasFrequency) {
            risk_rating_3 = calcRiskRating(likelihood_3, frequency_3, consequence_3);
            risk_rank_3 = calcRiskRank(risk_rating_3);
        }
    %>
    <div class="tr">
        <div class="td" style="padding-left: 5px">
            <span class="counter"><%= (n+1) %></span> <%= task_step %>
        </div>
        <div class="td" style="padding-left: 5px"><%= hazard %></div>
        <div class="td" style="padding-left: 5px"><%= risk %></div>

        <div class="td td-tr fixed-flex flex min-w-180 min-h-120 padding-0" style="min-width: 180px;">
            <div class="td fixed-flex td-calc td-rotate-single"><% if(contains("Safety")) { %> <span>Safety</span> <% } %></div>
            <div class="td fixed-flex td-calc td-rotate-single"><% if(contains("Health")) { %> <span>Health</span> <% } %></div>
            <div class="td fixed-flex td-calc td-rotate-single"><% if(contains("Environmental")) { %> <span>Environmental</span> <% } %></div>
            <div class="td fixed-flex td-calc td-rotate-single"><% if(contains("Quality")) { %> <span>Quality</span> <% } %></div>
            <div class="td fixed-flex td-calc td-rotate-single"><% if(contains("Financial")) { %> <span>Financial</span> <% } %></div>
        </div>

        <div class="td td-risk-rating td-tr fixed-flex flex padding-0" style="min-width: 180px;">
            <% if(hasFrequency) { %> <div class="td td-calc"><%= frequency_1 %></div><% } %>
            <div class="td td-calc"><%= likelihood_1 %></div>
            <div class="td td-calc"><%= consequence_1 %></div>
            <div class="td td-calc"><%= risk_rating_1 %></div>
            <div class="td td-calc td-risk-level"><%= risk_rank_1 %></div>
        </div>

        <div class="td td-risk-control-measures" style="padding-left: 5px">
            <% (control_measure_list || []).forEach((v, n) => { %>
            <span><i class="counter"><%= (n+1) %></i><%= v.text %></span>
            <% }); %>
        </div>
        <div class="td td-risk-rating td-tr fixed-flex flex padding-0" style="min-width: 180px;">
            <% if(hasFrequency) { %> <div class="td td-calc"><%= frequency_2 %></div><% } %>
            <div class="td td-calc"><%= likelihood_2 %></div>
            <div class="td td-calc"><%= consequence_2 %></div>
            <div class="td td-calc"><%= risk_rating_2 %></div>
            <div class="td td-calc td-risk-level"><%= risk_rank_2 %></div>
        </div>

        <% if(hasFrequency) { %> 
        <div class="td td-risk-control-measures" style="padding-left: 5px">
            <% (control_measure_list_additional || []).forEach((v, n) => { %>
            <span><i class="counter"><%= (n+1) %></i><%= v.text %></span>
            <% }); %>
        </div>
        <div class="td td-risk-rating td-tr fixed-flex flex padding-0" style="min-width: 180px;">
            <div class="td td-calc"><%= frequency_3 %></div>
            <div class="td td-calc"><%= likelihood_3 %></div>
            <div class="td td-calc"><%= consequence_3 %></div>
            <div class="td td-calc"><%= risk_rating_3 %></div>
            <div class="td td-calc td-risk-level"><%= risk_rank_3 %></div>
        </div>
        <% } %>

        <div class="td td-tr fixed-flex flex min-w-110 min-h-120 padding-0">
            <div class="td fixed-flex td-calc td-rotate-single"><span><%= responsible_personName %></span></div>
            <div class="td fixed-flex td-calc td-rotate-single"><span><%= Dates.formatDate(target_date) %></span></div>
            <div class="td fixed-flex td-calc td-rotate-single"><span><%= Dates.formatDate(due_date) %></span></div>
        </div>
    </div>
    <% });%>
</div>
<% }%>