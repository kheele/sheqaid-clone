{
    "name": "desktop-sheqassist-firebase-functions",
    "description": "Cloud Functions for Firebase",
    "scripts": {
        "test": "mocha --reporter spec",
        "lint": "eslint .",
        "deploy:functions": "cd ../ && firebase deploy --only functions",
        "deploy:firestore": "firebase deploy --only functions:firestore",
        "deploy:firestore:plugins": "firebase deploy --only functions:firestore:plugins",
        "deploy:firestore:plugins:hr": "firebase deploy --only functions:firestore:plugins:hr",
        "deploy:callables": "firebase deploy --only functions:callables",
        "deploy:callables-onSetCustomUserClaims": "firebase deploy --only functions:callables-onSetCustomUserClaims",
        "deploy:callables-onLogin": "firebase deploy --only functions:callables-onLogin",
        "deploy:callables-onLoginBiometric": "firebase deploy --only functions:callables-onLoginBiometric",
        "deploy:callables-onSetupBiometric": "firebase deploy --only functions:callables-onSetupBiometric",
        "deploy:callables-sendForgotPass": "firebase deploy --only functions:callables-sendForgotPass",
        "deploy:callables-updatePhone": "firebase deploy --only functions:callables-updatePhone",
        "emulators:start": "firebase emulators:start",
        "install:mod": "npm i node-blob --save"
    },
    "engines": {
        "node": "10"
    },
    "main": "index.js",
    "dependencies": {
        "@tensorflow/tfjs-core": "^3.13.0",
        "@tensorflow/tfjs-node": "^3.12.0",
        "@tensorflow/tfjs-node-gpu": "^3.13.0",
        "adv-firestore-functions": "^2.0.9",
        "atob": "^2.1.2",
        "canvas": "^2.9.0",
        "docx-pdf": "0.0.1",
        "ejs": "^3.1.6",
        "eslint-config-google": "^0.14.0",
        "exceljs": "^4.1.1",
        "face-api.js": "^0.22.2",
        "firebase": "^9.9.0",
        "firebase-admin": "^8.10.0",
        "firebase-functions": "^3.6.1",
        "formidable": "^1.2.2",
        "googleapis": "^67.1.0",
        "html-pdf": "^2.2.0",
        "moment": "2.24.0",
        "moment-timezone": "0.5.13",
        "node-blob": "0.0.2",
        "nodemailer": "^6.4.16"
    },
    "devDependencies": {
        "@types/mocha": "^9.1.0",
        "chai": "^4.3.6",
        "eslint": "^5.12.0",
        "eslint-plugin-promise": "^4.0.1",
        "firebase-functions-test": "^0.2.3",
        "mocha": "^9.2.2",
        "sinon": "^13.0.1"
    },
    "private": true
}
